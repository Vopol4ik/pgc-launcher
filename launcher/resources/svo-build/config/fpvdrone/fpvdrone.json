{
  // ═══════════════════════════════════════════════════════
  // FPV Drone — General Config
  // ═══════════════════════════════════════════════════════
  // Измените значения и перезапустите игру для применения.
  // Работает на клиенте и на выделенном сервере.
  // Настройки сервера применяются ко всем подключённым игрокам.

  // ── Простая дальность ──

  // Быстрая настройка дальности. Укажите максимальную дальность (в блоках) —
  // все остальные расстояния масштабируются автоматически.
  // 0 = ручная настройка.
  // Range: 0 (off) or 50 — 10000
  "simpleRange": 0,

  // ── Сигнал / Дальность ──
  // (Если simpleRange > 0, расстояния масштабируются автоматически
  //  и значения ниже игнорируются.)

  // Максимальная дальность полёта в блоках. За этим пределом сигнал
  // падает до нуля и активируется аварийный режим.
  // Range: 50 — 10000
  "maxRange": 350,

  // Расстояние (в блоках), с которого начинается замерзание видео.
  // Ближе этого расстояния изображение абсолютно чистое.
  // Range: 0 — 10000
  "freezeStartDistance": 100,

  // Штраф сигнала от блоков между пилотом и дроном.
  // 0.0 = препятствия не влияют. 1.0 = стандартно. 2.0 = вдвое сильнее.
  // Range: 0.0 — 10.0
  "obstaclePenaltyMultiplier": 1.0,

  // Максимальный штраф сигнала (%) при полёте у земли на дистанции.
  // Имитирует затухание сигнала у поверхности. 0 = отключено.
  // Range: 0.0 — 100.0
  "groundProximityPenaltyMax": 35.0,

  // Расстояние (в блоках), с которого начинает действовать
  // штраф за близость к земле. Ближе этого порога — штрафа нет.
  // Range: 0 — 10000
  "groundProximityDistanceStart": 30,

  // Высота над землёй (в блоках), ниже которой дрон считается
  // низколетящим для расчёта штрафа за близость к земле.
  // Range: 1 — 256
  "groundProximityHeightThreshold": 15,

  // Бонус сигнала на каждый блок высоты выше базовой отметки.
  // Высокий полёт = лучший сигнал. 0 = без бонуса.
  // Range: 0.0 — 10.0
  "heightBonusPerBlock": 0.1,

  // Уровень Y, выше которого начинает действовать бонус высоты.
  // Полёт ниже этой отметки не даёт бонуса.
  // Range: -64 — 320
  "heightBaseline": 64,

  // Скорость изменения уровня сигнала.
  // Малые значения = плавный переход. Большие = мгновенный отклик.
  // Range: 0.01 — 1.0
  "signalSmoothing": 0.15,

  // Количество кадров с нулевым сигналом до срабатывания аварийного режима.
  // Большие значения = допуск кратких потерь сигнала.
  // Range: 1 — 600
  "zeroSignalFramesForDisconnect": 30,

  // ── Замерзание видео ──

  // Интенсивность замерзания видео при ухудшении сигнала.
  // Больше = сильнее замерзает на дистанции. 0 = без замерзания.
  // Range: 0.0 — 50.0
  "freezeIntensity": 5.0,

  // ── Аварийный режим ──

  // Скорость снижения (блоков/тик) при потере сигнала.
  // Дрон медленно опускается до приземления или восстановления сигнала.
  // Range: 0.0 — 10.0
  "failsafeDescentRate": 0.5,

  // Горизонтальное торможение за тик в аварийном режиме.
  // 1.0 = без торможения. 0.0 = мгновенная полная остановка.
  // Range: 0.0 — 1.0
  "failsafeHorizontalDamping": 0.95,

  // ── Взрыв ──

  // Сила разрушения блоков. 0.0 = блоки не разрушаются.
  // 1.0 = как у TNT. 2.0 = вдвое мощнее TNT.
  // Range: 0.0 — 2.0
  "explosionBlockPower": 0.0,

  // Радиус ударной волны в блоках.
  // Range: 1.0 — 32.0
  "explosionBlastRadius": 10.0,

  // Максимальный урон ударной волны на границе зоны мгновенного поражения.
  // Range: 0.0 — 200.0
  "explosionBlastDamage": 40.0,

  // Радиус мгновенного поражения (в блоках). Все существа внутри
  // погибают вне зависимости от брони.
  // Range: 0.0 — 16.0
  "explosionKillZone": 2.0,

  // Если включено, взрыв принудительно открывает все двери,
  // люки и калитки в радиусе взрыва.
  "explosionOpensDoors": true,

  // Мощность взрыва камикадзе / РПГ-дрона.
  // Масштабирует радиус осколков и урон.
  // Range: 1.0 — 10.0
  "kamikazeExplosionPower": 4.0,

  // Количество осколочных лучей при взрыве.
  // Больше = лучшее покрытие через укрытия, но выше нагрузка на CPU.
  // Range: 8 — 512
  "shrapnelCount": 128,

  // ── Урон ──

  // Если включено, дрон наносит урон от столкновения
  // существам (мобам и игрокам).
  "droneCollisionDamage": true,

  // ── Дальность наблюдения ──

  // Дальность отслеживания дрона (в блоках). Определяет, как далеко
  // наблюдатели видят движение и анимации дрона.
  // Только на сервере — не синхронизируется с клиентами.
  // Range: 64 — 2048
  "droneObserverRange": 500,

  // ── Client Settings (camera, input, video — ignored on dedicated servers) ──

  // Camera tilt angle in degrees
  "defaultAngle": 25.0,

  // Field of view in degrees
  "fov": 120.0,

  // Force keyboard+mouse input, ignore connected controller
  "forceKbm": false,

  // Show stick position overlay during flight
  "stickOverlay": false,

  // Video resolution scale: RES_10, RES_15, RES_20, RES_25, RES_33, RES_50
  "videoResolution": "RES_25"
}
